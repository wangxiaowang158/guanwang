# ===== Docker 部署环境变量 —— 复制为 .env 后填写 =====
#   cp .env.docker.example .env
#
# 本文件只服务于 docker-compose.yaml，与仓库根的 .env.example 用途不同：
#   .env.example        → 非 Docker 部署时给 server/.env、admin/.env 抄参数用
#   .env.docker.example → 本文件，compose 直接读取，注入容器环境变量
#
# 不需要在此填域名。网关按端口分流（8080 admin / 8081 web），
# 域名只在宿主机宝塔的反向代理里配置，以后换域名不用动这里。
#
# 【宝塔反代必须加一行】宝塔是最外层，须覆盖而非追加客户端自带的 XFF：
#   proxy_set_header X-Forwarded-For $remote_addr;
# 缺了这行，访客可在请求头里伪造 IP，绕过留言限流与登录失败锁定。
# 若宝塔前面还有 CDN / 负载均衡，改为按其文档配置 real_ip，否则全站共用一个限流桶。
#
# 【首次启动】backend 会自动建表并写入初始栏目。若首启中途失败、重启后前台内容不全，
# 手动补一次（内容与站点信息不会重复写，但栏目的路径/锚点/头图文案会重置为种子值，
# 故只在首启失败、后台尚未改过配置时使用）：
#   docker compose run --rm backend node dist/scripts/seed-cms.js

# ============ 必填：密钥与初始口令 ============
# MySQL root 密码。建议纯字母数字，含 $ # ! 等符号在 shell 与 compose 插值中易出错
MYSQL_ROOT_PASSWORD=

# 应用库密码（后端连库用的就是这个账号，非 root）
MYSQL_PASSWORD=

# 会员令牌签发密钥。生成：openssl rand -hex 32
JWT_MEMBER_SECRET=

# 管理员令牌签发密钥。生成：openssl rand -hex 32
# 必须与 JWT_MEMBER_SECRET 不同值 —— 两套身份靠密钥 + scope 双重隔离。
# 留空会让后端回落到源码内的开发默认值，等于任何人都能伪造管理员令牌登进后台
JWT_ADMIN_SECRET=

# 初始管理员密码，仅在管理员表为空时用于创建首个账号（账号名见下方可选段）
# 建议至少 12 位；首次登录后请立即在后台改密。
# 留空也可以：后端会随机生成一个强口令，并在创建账号时打进 backend 容器日志
# （docker compose logs backend | grep 初始管理员），该口令只出现那一次
ADMIN_SEED_PASSWORD=

# ============ 可选：一般保持默认 ============
# 数据库名与应用账号名
MYSQL_DATABASE=zrh_website
MYSQL_USER=zrh

# 表结构无需手工处理：backend 容器每次启动先自动执行迁移，
# 全新库会建出完整结构并写入初始栏目与站点信息（见 docker/server-entrypoint.sh）。
# compose 里 DB_SYNCHRONIZE 固定为 false，此处不提供开关

# 会员与管理员令牌有效期
JWT_MEMBER_EXPIRES_IN=2h
JWT_ADMIN_EXPIRES_IN=8h

# 初始管理员账号名（密码见上方必填段）
ADMIN_SEED_ACCOUNT=admin

# 图片上传单文件大小上限（MB）。上传目录已固定挂载为 backend-uploads 卷
UPLOAD_MAX_MB=2

# 视频上传单文件大小上限（MB）。改大时须同步网关 client_max_body_size
UPLOAD_VIDEO_MAX_MB=100

# 限流：时间窗口（秒）与窗口内最大请求数
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# 图形验证码 / 短信验证码的存储，指向 compose 内的 redis 服务。
# 留空则退回进程内存：backend 重启后验证码全部失效，多副本下答案互相对不上
REDIS_URL=redis://redis:6379/0
# 键前缀，避免与同一 Redis 上的其他应用撞键
REDIS_KEY_PREFIX=zrh:
# 单条命令超时（毫秒）。Redis 卡住时宁可快速失败，不要把请求线程拖死
REDIS_COMMAND_TIMEOUT_MS=2000

# 跨域放行来源。两个前端均经 gateway 同源访问 /api，故留空即可。
# 仅当前端与后端分属不同域名时才需填写，逗号分隔
CORS_ORIGINS=

# 新反馈到达通知：留空则不推送，客户留言照常落库
# 群机器人 webhook 地址，其中含密钥，勿提交到仓库
FEEDBACK_NOTIFY_WEBHOOK=
# 机器人类型：wecom（企业微信）/ dingtalk（钉钉）/ feishu（飞书）
FEEDBACK_NOTIFY_TYPE=wecom
# 推送超时（毫秒）：超时只记日志，不影响反馈落库
FEEDBACK_NOTIFY_TIMEOUT_MS=3000

# 封面图「AI 生成」：OpenAI 兼容的 /images/generations 接口
# 密钥留空即关闭该功能，其余上传方式不受影响；密钥含机密，勿提交到仓库
AI_IMAGE_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_API_KEY=
# 每次生成的候选张数（即费用倍数）、图片尺寸与超时毫秒数
AI_IMAGE_COUNT=5
AI_IMAGE_SIZE=1536x1024
AI_IMAGE_TIMEOUT_MS=90000

# ============ 镜像来源（CI 构建方式相关）============
# GHCR 镜像归属的 GitHub 用户名，必须全小写。
# 用自己 fork 的仓库时改成自己的用户名，否则会拉到别人的镜像
IMAGE_OWNER=wangxiaowang158

# 镜像标签。日常保持 latest；
# 回滚时改为历史标签 sha-<短哈希>（在 GitHub 仓库 → Packages 里查），
# 再执行 docker compose pull && docker compose up -d
IMAGE_TAG=latest
