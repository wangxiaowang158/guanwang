# ===== Docker 部署环境变量 —— 复制为 .env 后填写 =====
#   cp .env.docker.example .env
#
# 本文件只服务于 docker-compose.yaml，与仓库根的 .env.example 用途不同：
#   .env.example        → 非 Docker 部署时给 server/.env、admin/.env 抄参数用
#   .env.docker.example → 本文件，compose 直接读取，注入容器环境变量
#
# 不需要在此填域名。网关按端口分流（8080 admin / 8081 web），
# 域名只在宿主机宝塔的反向代理里配置，以后换域名不用动这里。

# ============ 必填：密钥与初始口令 ============
# MySQL root 密码。建议纯字母数字，含 $ # ! 等符号在 shell 与 compose 插值中易出错
MYSQL_ROOT_PASSWORD=

# 应用库密码（后端连库用的就是这个账号，非 root）
MYSQL_PASSWORD=

# Redis 密码，不能留空。留空会导致 Redis 未授权访问
REDIS_PASSWORD=

# 会员令牌签发密钥。生成：openssl rand -hex 32
JWT_MEMBER_SECRET=

# 管理员令牌签发密钥。生成：openssl rand -hex 32
# 必须与 JWT_MEMBER_SECRET 不同值 —— 两套身份靠密钥 + scope 双重隔离。
# 留空会让后端回落到源码内的开发默认值，等于任何人都能伪造管理员令牌登进后台
JWT_ADMIN_SECRET=

# 初始管理员密码，仅在管理员表为空时用于创建首个账号（账号名见下方可选段）
# 建议至少 12 位；首次登录后请立即在后台改密
ADMIN_SEED_PASSWORD=

# ============ 可选：一般保持默认 ============
# 数据库名与应用账号名
MYSQL_DATABASE=zrh_website
MYSQL_USER=zrh

# 表结构自动同步。项目无迁移脚本，首次部署须为 true 建表；
# 建表完成后改为 false 并重启 backend，避免后续启动擅自改动线上表结构
DB_SYNCHRONIZE=true

# 会员与管理员令牌有效期
JWT_MEMBER_EXPIRES_IN=2h
JWT_ADMIN_EXPIRES_IN=8h

# 初始管理员账号名（密码见上方必填段）
ADMIN_SEED_ACCOUNT=admin

# 图片上传单文件大小上限（MB）。上传目录已固定挂载为 backend-uploads 卷
UPLOAD_MAX_MB=2

# 视频上传单文件大小上限（MB）。改大时须同步网关 client_max_body_size
UPLOAD_VIDEO_MAX_MB=100

# 限流：时间窗口（秒）与窗口内最大请求数
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# 跨域放行来源。两个前端均经 gateway 同源访问 /api，故留空即可。
# 仅当前端与后端分属不同域名时才需填写，逗号分隔
CORS_ORIGINS=

# ============ 镜像来源（CI 构建方式相关）============
# GHCR 镜像归属的 GitHub 用户名，必须全小写。
# 用自己 fork 的仓库时改成自己的用户名，否则会拉到别人的镜像
IMAGE_OWNER=wangxiaowang158

# 镜像标签。日常保持 latest；
# 回滚时改为历史标签 sha-<短哈希>（在 GitHub 仓库 → Packages 里查），
# 再执行 docker compose pull && docker compose up -d
IMAGE_TAG=latest
