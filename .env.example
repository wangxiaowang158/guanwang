# ===== 中瑞恒官网 monorepo 环境变量总清单 =====
# 本文件汇总三个子项目的全部环境变量，作为查阅与复制的唯一模板。
# 它不被任何程序直接读取 —— 框架只从各子项目自己的目录加载 .env：
#   server → server/.env（ConfigModule envFilePath: '.env'）
#   admin  → admin/.env （Vite 默认 envDir）
#   web    → web/.env   （Vite 默认 envDir）
#
# 使用方式：
#   server：必须手工创建，取下方 [1] 段内容
#           cp .env.example server/.env  然后删掉 VITE_ 两段并填真实密钥
#   admin ：仓库已含 admin/.env，clone 后开箱可跑（内置 Mock，无需后端）
#           要改本机配置就新建 admin/.env.local 覆盖（不提交）
#   web   ：同上，见 web/.env 与 web/.env.local
#
# 【重要】admin 与 web 有同名变量但取值不同（VITE_PORT 3810/3820、
#         VITE_BASE_URL 的子目录路径等），两段不可混用，按段落各取所需。
# 【重要】新增 VITE_ 变量时，需同步 admin/src/env.d.ts 或 web/src/env.d.ts 的类型声明。

# ============================================================
# [1] 后端接口 server —— 复制到 server/.env
#     该文件含密钥，已被 .gitignore 拦截，每台机器需各自生成
# ============================================================

# 服务端口（前端两段的 VITE_PROXY_TARGET 需与此一致）
PORT=3000

# 数据库类型：sqlite（起步）/ mysql（后续切换）
DB_TYPE=sqlite

# SQLite 数据文件路径（相对 server 目录）
DB_SQLITE_PATH=data/website.sqlite

# 开发期自动同步表结构；正式环境必须为 false 并改用迁移脚本
DB_SYNCHRONIZE=true

# MySQL 连接参数（DB_TYPE=mysql 时生效）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=zrh_website

# 会员令牌签发密钥（scope=member）——上线前必须替换为强随机值
JWT_MEMBER_SECRET=dev-member-secret-change-me
JWT_MEMBER_EXPIRES_IN=2h

# 管理端临时占位令牌（开发期用，正式鉴权落地后删除）
# 须与 admin 段的 VITE_MGMT_DEV_TOKEN 保持一致
MGMT_DEV_TOKEN=dev-mgmt-token-change-me

# 限流：时间窗口（秒）与窗口内最大请求数
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# 跨域放行来源，逗号分隔（admin 与 web 的开发地址）
CORS_ORIGINS=http://localhost:3810,http://localhost:3820

# ============================================================
# [2] 后台管理端 admin —— 对应 admin/.env（仓库已提交默认值）
#     本机差异化配置请写入 admin/.env.local
# ============================================================

# 部署基础路径：根域名部署填 /；子目录部署填 /admin/；也可填 CDN 绝对地址
VITE_BASE_URL=/

# 开发服务器端口
VITE_PORT=3810

# Mock 开关：true 启用内置 Mock 数据，false 走真实后端（此时依赖下方代理配置）
VITE_USE_MOCK=true

# 接口基础地址：留空表示同源相对路径（配合 Mock 或 VITE_PROXY_TARGET 代理）
# 直连独立域名后端时填完整地址，如 https://api.example.com
VITE_API_BASE_URL=

# 真实后端代理目标：VITE_USE_MOCK=false 且 VITE_API_BASE_URL 为空时，
# 由开发服务器把 VITE_API_PREFIX 前缀的请求代理到此地址
VITE_PROXY_TARGET=http://localhost:3000

# 接口路径前缀（需与后端一致，同时决定代理规则匹配的路径）
# 需要「无前缀」时填 /（留空会被视为未配置并回退默认 /api）
VITE_API_PREFIX=/api

# 管理端临时占位令牌：会员/反馈等真实后端接口（/api/mgmt/*）的通行凭证
# 【严禁公网部署】后端未实现管理员认证前的开发期措施，须与 server 段 MGMT_DEV_TOKEN 一致
VITE_MGMT_DEV_TOKEN=dev-mgmt-token-change-me

# 地图行政区划数据源（第三方公开服务，经 /map-api 前缀代理避免跨域）
VITE_MAP_API_TARGET=https://geo.datav.aliyun.com

# 图片上传大小上限（MB）；类型白名单固定为 JPG/PNG/WebP/GIF，见 src/config
VITE_UPLOAD_MAX_MB=2

# 标注保存中间件开关：仅原型标注流程需要，生产/常规开发可置 false
VITE_ENABLE_ANNOTATION_SAVE=true

# ============================================================
# [3] 官网前台 web —— 对应 web/.env（仓库已提交默认值）
#     本机差异化配置请写入 web/.env.local
#     注意：以下变量名与 [2] 段重复，取值不同，两段不可混写在同一文件
# ============================================================

# 部署基础路径：根域名部署填 /；子目录部署填 /site/；也可填 CDN 绝对地址
VITE_BASE_URL=/

# 开发服务器端口
VITE_PORT=3820

# Mock 开关：true 启用内置 Mock 数据，false 走真实后端（此时依赖下方代理配置）
VITE_USE_MOCK=true

# 接口基础地址：留空表示同源相对路径（配合 Mock 或 VITE_PROXY_TARGET 代理）
VITE_API_BASE_URL=

# 真实后端代理目标（同 server 段的 PORT）
VITE_PROXY_TARGET=http://localhost:3000

# 接口路径前缀（需与后端一致）
VITE_API_PREFIX=/api
