{
  "name": "website-cms-server",
  "version": "1.0.0",
  "description": "通用官网管理系统后端 - NestJS + TypeORM + MySQL",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/typeorm.datasource.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migrate": "ts-node src/scripts/run-migrations.ts",
    "verify:schema": "ts-node src/scripts/verify-schema.ts",
    "smoke:member": "ts-node src/scripts/smoke-member.ts",
    "smoke:lockout": "ts-node src/scripts/smoke-lockout.ts",
    "smoke:feedback": "ts-node src/scripts/smoke-feedback.ts",
    "smoke:media": "ts-node src/scripts/smoke-media.ts",
    "smoke:prerender": "ts-node src/scripts/smoke-prerender.ts",
    "seed:feedback": "ts-node src/scripts/seed-feedback.ts",
    "seed:cms": "ts-node src/scripts/seed-cms.ts",
    "verify:cms": "ts-node src/scripts/verify-cms-parity.ts",
    "verify:migration": "ts-node src/scripts/verify-migration-parity.ts",
    "clean:uploads": "ts-node src/scripts/clean-orphan-uploads.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "17.4.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.11.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.1"
  }
}
