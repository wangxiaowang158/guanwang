{
  "name": "smart-factory-inspection",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "npm run type-check:app && npm run type-check:build",
    "type-check:app": "vue-tsc --noEmit",
    "type-check:build": "tsc --noEmit --ignoreConfig --skipLibCheck --strict --module esnext --moduleResolution bundler --target es2022 --types node vite.config.ts build/*.ts"
  },
  "dependencies": {
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/vue-3": "^3.22.5",
    "ant-design-vue": "^4.1.0",
    "axios": "^1.6.0",
    "dompurify": "^3.4.9",
    "echarts": "^6.0.0",
    "marked": "^18.0.2",
    "sortablejs": "^1.15.7",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/mockjs": "^1.0.10",
    "@types/node": "^25.5.2",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.0.0",
    "mockjs": "^1.1.0",
    "sass": "^1.99.0",
    "typescript": "^6.0.2",
    "vite": "^5.1.0",
    "vue-tsc": "^3.2.6"
  }
}
